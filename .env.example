# Which deployment to control. Point this at a local dev server
# (http://localhost:3000) to test against a scratch database, or at production.
SITE_URL=https://justin06lee.dev

# Same ADMIN_KEY the site itself is deployed with — this is the only credential
# the server holds, and it grants full admin. Never commit it.
ADMIN_KEY=

# Optional. Per-request timeout in milliseconds (default 15000).
#REQUEST_TIMEOUT_MS=15000
