# Which main-site deployment to control. Point this at a local dev server
# (http://localhost:3000) to test against a scratch database, or at production.
SITE_URL=https://justin06lee.dev

# Same ADMIN_KEY the main site itself is deployed with — grants full admin.
# Required. Never commit it.
ADMIN_KEY=

# truman.justin06lee.dev (private live-video room). Optional — the truman_*
# tools register either way but need the owner key to work.
#TRUMAN_URL=https://truman.justin06lee.dev
TRUMAN_OWNER_KEY=

# listen.justin06lee.dev (synced music room). Optional — reading the room is
# public; the owner key enables listen_set_room.
#LISTEN_URL=https://listen.justin06lee.dev
LISTEN_OWNER_KEY=

# todo / coffee / oddjob are deployed with the SAME shared ADMIN_KEY as the
# main site, so only their URLs are configurable (defaults shown).
#TODO_URL=https://todo.justin06lee.dev
#COFFEE_URL=https://coffee.justin06lee.dev
#ODDJOB_URL=https://oddjob.justin06lee.dev

# leet.justin06lee.dev has its OWN admin key (not the shared one). Optional —
# the leet_* tools register either way but need it to work.
#LEET_URL=https://leet.justin06lee.dev
LEET_ADMIN_KEY=

# Optional. Per-request timeout in milliseconds (default 15000).
#REQUEST_TIMEOUT_MS=15000
