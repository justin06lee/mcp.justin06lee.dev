{
  "name": "@justin06lee/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for controlling justin06lee.dev without touching code",
  "type": "module",
  "bin": {
    "justin06lee-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist --minify",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run build && bun run scripts/smoke.ts",
    "check": "bun run typecheck && bun run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
