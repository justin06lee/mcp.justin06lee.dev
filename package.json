{
  "name": "@justin06lee/mcp",
  "version": "0.4.0",
  "private": true,
  "description": "MCP server for controlling justin06lee.dev without touching code",
  "type": "module",
  "files": [
    "dist",
    "install.sh"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/justin06lee-mcp",
    "build:linux": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/justin06lee-mcp-linux-x64",
    "bundle": "bun build src/index.ts --target=node --outdir=dist --minify",
    "doctor": "bun run src/index.ts --doctor",
    "install:otto": "./install.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke": "bun run bundle && bun run scripts/smoke.ts",
    "check": "bun run typecheck && bun run test && bun run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
